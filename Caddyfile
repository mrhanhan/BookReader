:80 {
	encode zstd gzip

	# Everything dynamic lives under /api; /healthz lets operators check the
	# server through the same public entry point.
	@backend path /api/* /healthz
	handle @backend {
		reverse_proxy server:3000
	}

	handle {
		root * /srv

		# index.html (and SPA deep links) must always be revalidated so a new
		# deployment is picked up; hashed Vite assets are immutable.
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
