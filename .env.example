# Bookr deployment configuration.
# Copy to `.env` and replace every `change-me` value before the first start:
#   cp .env.example .env && chmod 600 .env
# `.env` is read by `docker compose` for variable substitution; the backup
# scripts read their variables from the environment (see the end of this file).

# --- Postgres ---------------------------------------------------------------
# Password of the `bookr` database role. Use a long random value. It is
# embedded in DATABASE_URL, so prefer URL-safe characters (letters, digits,
# '-', '_') or percent-encode anything else.
POSTGRES_PASSWORD=change-me-postgres-password

# --- MinIO / S3 -------------------------------------------------------------
# MinIO root credentials; the server creates the `bookr` bucket on startup.
# The secret must be at least 8 characters (MinIO requirement).
S3_ACCESS_KEY=bookr
S3_SECRET_KEY=change-me-minio-secret
# Bucket name is fixed in docker-compose.yml: S3_BUCKET=bookr

# --- Application secrets ----------------------------------------------------
# HS256 signing key for access tokens, at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-secret-at-least-32-characters

# --- Quotas and limits ------------------------------------------------------
# Total storage for the shared library: 80 GiB.
LIBRARY_QUOTA_BYTES=85899345920
# Per-member upload quota: 20 GiB.
MEMBER_UPLOAD_QUOTA_BYTES=21474836480
# Login attempts per window and client IP.
LOGIN_RATE_LIMIT=10

# --- Web / CORS -------------------------------------------------------------
# Public origin of the browser app. Must match the URL users open, including
# scheme and port; change it when you put the app behind a domain or HTTPS.
CORS_ORIGIN=http://localhost:8180

# Optional: debug|info|warn|error
LOG_LEVEL=info

# --- Backup scripts (not read by docker compose) ----------------------------
# scripts/backup-export.sh runs on the server host. Defaults shown in comments.
# BACKUP_ROOT=/srv/bookr/backups
# COMPOSE_DIR=/srv/bookr
# BACKUP_KEEP_DAYS=30
# COMPOSE_NETWORK=bookr_default
#
# scripts/pull-backup.sh runs on the backup PC (WSL or Task Scheduler).
# BOOKR_BACKUP_SOURCE=bookr@server.example:/srv/bookr/backups
# BOOKR_BACKUP_DEST=/home/bookr/bookr-backups
# RESTIC_REPOSITORY=sftp:backup@nas.example:/srv/restic/bookr
# RESTIC_PASSWORD_FILE=/home/bookr/.config/bookr/restic-password
# Optional SSH command override for rsync, e.g. "ssh -p 2222":
# BOOKR_SSH=ssh
