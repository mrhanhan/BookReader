# Bookr deployment configuration.
# Copy to `.env` and replace every `change-me` value before the first start:
#   cp .env.example .env && chmod 600 .env
# `.env` is read by `docker compose` for variable substitution; the backup
# scripts read their variables from the environment (see the end of this file).

# --- Postgres ---------------------------------------------------------------
# Password of the `bookr` database role. Use a long random value. It is
# embedded in DATABASE_URL, so prefer URL-safe characters (letters, digits,
# '-', '_') or percent-encode anything else.
POSTGRES_PASSWORD=change-me-postgres-password

# --- MinIO / S3 -------------------------------------------------------------
# MinIO root credentials; the server creates the `bookr` bucket on startup.
# The secret must be at least 8 characters (MinIO requirement).
S3_ACCESS_KEY=bookr
S3_SECRET_KEY=change-me-minio-secret
# Address the *browser* uses for presigned uploads and covers. Compose defaults
# it to the host-published MinIO port; use the public MinIO URL when users
# connect from other machines.
# S3_PUBLIC_ENDPOINT=http://localhost:9200
# Bucket name is fixed in docker-compose.yml: S3_BUCKET=bookr

# --- Application secrets ----------------------------------------------------
# HS256 signing key for access tokens, at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-a-random-secret-at-least-32-characters

# --- AI companion -----------------------------------------------------------
# Optional key-encryption secret for the provider API key stored in Postgres,
# at least 32 characters (openssl rand -base64 48). When unset, the key is
# derived from JWT_SECRET with HKDF-SHA256: rotating JWT_SECRET then makes the
# stored AI key unreadable, so re-enter it in the admin settings afterwards.
# AI_CONFIG_SECRET=
#
# The provider is normally configured once through PUT /api/admin/ai and stored
# encrypted; those values win on every later start. The variables below only
# seed an empty configuration table and are ignored once a row exists.
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_CHAT_MODEL=deepseek-chat
# AI_REASONER_MODEL=deepseek-reasoner
#
# Deterministic local provider for demos and end-to-end tests. Never enable it
# in production.
# AI_FAKE_PROVIDER=0
#
# Token budget spent on book context per request (1000-32000) and provider
# request timeout in milliseconds (5000-120000).
# AI_CONTEXT_TOKEN_BUDGET=8000
# AI_REQUEST_TIMEOUT_MS=60000

# --- Quotas and limits ------------------------------------------------------
# Total storage for the shared library: 80 GiB.
LIBRARY_QUOTA_BYTES=85899345920
# Per-member upload quota: 20 GiB.
MEMBER_UPLOAD_QUOTA_BYTES=21474836480
# Login attempts per window and client IP.
LOGIN_RATE_LIMIT=10

# --- Web / CORS -------------------------------------------------------------
# Comma-separated allowlist of origins that may call the API. The compose
# default is the web app plus the native webviews:
#   http://localhost:8180,https://tauri.localhost,http://tauri.localhost,https://localhost,capacitor://localhost
# Replace the web entry with the public HTTPS origin when you deploy a domain,
# and keep the Tauri/Capacitor entries for the desktop and Android shells.
# CORS_ORIGIN=http://localhost:8180,https://tauri.localhost,http://tauri.localhost,https://localhost,capacitor://localhost

# --- Native builds ----------------------------------------------------------
# API origin baked into the web bundle at build time. Leave empty for the
# same-origin web deployment (Caddy serves /api). Builds packaged into the
# Tauri desktop shell or the Capacitor Android app must bake in the absolute
# server origin, and that same origin must be present in CORS_ORIGIN:
#   VITE_API_BASE_URL=https://bookr.example.com pnpm --filter @bookr/web build
# VITE_API_BASE_URL=

# MinIO CORS for presigned EPUB/PDF URLs fetched directly by the browser.
# Defaults to '*' in docker-compose.yml; narrow it to the app origins if the
# public MinIO endpoint is reachable from other sites.
# MINIO_API_CORS_ALLOW_ORIGIN=*

# Optional: debug|info|warn|error
LOG_LEVEL=info

# --- Backup scripts (not read by docker compose) ----------------------------
# scripts/backup-export.sh runs on the server host. Defaults shown in comments.
# BACKUP_ROOT=/srv/bookr/backups
# COMPOSE_DIR=/srv/bookr
# BACKUP_KEEP_DAYS=30
# COMPOSE_NETWORK=bookr_default
#
# scripts/pull-backup.sh runs on the backup PC (WSL or Task Scheduler).
# BOOKR_BACKUP_SOURCE=bookr@server.example:/srv/bookr/backups
# BOOKR_BACKUP_DEST=/home/bookr/bookr-backups
# RESTIC_REPOSITORY=sftp:backup@nas.example:/srv/restic/bookr
# RESTIC_PASSWORD_FILE=/home/bookr/.config/bookr/restic-password
# Optional SSH command override for rsync, e.g. "ssh -p 2222":
# BOOKR_SSH=ssh
